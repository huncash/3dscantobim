# 3dscantobim.hu – másolás: cp .env.example .env
# Titkot, jelszót és API-kulcsot ne tegyél a verziókezelt fájlba.
# Ez a folyamat a site-7 sajátja. Ne mutasson a site-1, site-6 vagy site-8
# portjára, adatfájljára, sütijére vagy feltöltési könyvtárára.

SITE_NAME=3dscantobim
SITE_URL=https://3dscantobim.hu

# A site-7 saját portja. A 3dscantobim.hu upstreamje: 127.0.0.1:7000.
# Ne válts automatikusan másik portra, ha a 7000 foglalt.
PORT=7000
BIND_HOST=127.0.0.1
NODE_ENV=production

# Csak akkor 1, ha a 7000-es portot kizárólag a reverse proxy éri el.
TRUST_PROXY=0

# Saját sqlite fájl. Ne mutasson másik site adatbázisára.
DATA_FILE=./data/leads.sqlite
# Alternatíva a DATA_FILE helyett. Közös Postgres vagy más szerver nem támogatott.
# DATABASE_URL=sqlite:./data/leads.sqlite

CONTACT_EMAIL=info@3dscantobim.hu
CONTACT_PHONE=+36 30 667 2510

COMPANY_LEGAL_NAME=ADP-TOP Kereskedelmi és Szolgáltató Kft.
COMPANY_SHORT_NAME=ADP-TOP Kft.
COMPANY_SEAT=1116 Budapest, Híradó utca 29.
COMPANY_REG_NUMBER=01-09-872622
COMPANY_COURT=Fővárosi Törvényszék Cégbírósága
COMPANY_TAX_ID=13777164-2-43
COMPANY_EU_TAX_ID=HU13777164
COMPANY_ACTIVITY=4712 – Iparcikk jellegű vegyes kiskereskedelem

# Közzététel előtt töltsd ki a tényleges tárhelyszolgáltatóval.
HOSTING_PROVIDER=
HOSTING_ADDRESS=
HOSTING_EMAIL=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SEND_CUSTOMER_COPY=true

# Legalább 16 karakter. A lenti példa szándékosan nem fogadható el.
ADMIN_TOKEN=cserelje-le-egy-hosszu-veletlen-szovegre
SESSION_SECRET=

RETENTION_MONTHS=24
